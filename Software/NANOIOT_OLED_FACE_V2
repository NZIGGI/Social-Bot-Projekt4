#include <Servo.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

Servo panServo;
Servo tiltServo;

// --------------------
// Servo Positionen
// --------------------
int panPos = 90;
int tiltPos = 90;

int oldPanPos = 90;

// --------------------
// Augen
// --------------------
int eyeWidth = 18;
int eyeHeight = 16;

int leftEyeX = 24;
int rightEyeX = 86;

int eyeY = 14;

int pupilSize = 3;
int pupilOffsetX = 0;

// --------------------
// Mund
// --------------------
String currentViseme = "REST";

int mouthX = 64;
int mouthY = 46;

// --------------------
// Gesicht zeichnen
// --------------------
void drawFace(int currentEyeHeight) {

    display.clearDisplay();

    // --------------------
    // Augen
    // --------------------
    display.fillRoundRect(
        leftEyeX,
        eyeY,
        eyeWidth,
        currentEyeHeight,
        5,
        SSD1306_WHITE
    );

    display.fillRoundRect(
        rightEyeX,
        eyeY,
        eyeWidth,
        currentEyeHeight,
        5,
        SSD1306_WHITE
    );

    // Pupillen
    if (currentEyeHeight > 6) {

        int pupilY = eyeY + currentEyeHeight / 2;

        display.fillCircle(
            leftEyeX + eyeWidth / 2 + pupilOffsetX,
            pupilY,
            pupilSize,
            SSD1306_BLACK
        );

        display.fillCircle(
            rightEyeX + eyeWidth / 2 + pupilOffsetX,
            pupilY,
            pupilSize,
            SSD1306_BLACK
        );
    }

    // --------------------
    // Mund
    // --------------------
    drawMouth(currentViseme);

    display.display();
}

// --------------------
// Mundformen
// --------------------
void drawMouth(String v) {

    // REST
    if (v == "REST") {

    int startX = mouthX - 18;
    int endX = mouthX + 18;

    for (int x = startX; x <= endX; x++) {

        int dx = x - mouthX;

        // leichte Smile-Kurve
        int y = mouthY - (0.018 * dx * dx);

        display.drawPixel(x, y, SSD1306_WHITE);
        display.drawPixel(x, y + 1, SSD1306_WHITE);
    }
    }

    // A
    else if (v == "A") {
        display.drawRoundRect(mouthX - 12, mouthY - 10, 24, 20, 6, SSD1306_WHITE);
        display.fillRoundRect(mouthX - 6, mouthY - 5, 12, 10, 3, SSD1306_WHITE);
    }

    // E
    else if (v == "E") {
        display.drawRoundRect(mouthX - 18, mouthY - 6, 36, 12, 4, SSD1306_WHITE);
        display.fillRect(mouthX - 12, mouthY - 2, 24, 4, SSD1306_WHITE);
    }

    // O
    else if (v == "O") {
        display.drawCircle(mouthX, mouthY, 10, SSD1306_WHITE);
        display.fillCircle(mouthX, mouthY, 4, SSD1306_WHITE);
    }

    // M
    else if (v == "M") {
        display.fillRect(mouthX - 16, mouthY - 1, 32, 3, SSD1306_WHITE);
    }

    // F
    else if (v == "F") {
        display.drawRoundRect(mouthX - 16, mouthY - 5, 32, 10, 4, SSD1306_WHITE);
        display.drawLine(mouthX - 10, mouthY, mouthX + 10, mouthY, SSD1306_WHITE);
    }

    // S
    else if (v == "S") {
        display.drawRoundRect(mouthX - 18, mouthY - 4, 36, 8, 3, SSD1306_WHITE);
    }
}

// --------------------
// Blinzeln
// --------------------
void blink() {

    for (int h = eyeHeight; h >= 2; h -= 2) {
        drawFace(h);
        delay(12);
    }

    delay(50);

    for (int h = 2; h <= eyeHeight; h += 2) {
        drawFace(h);
        delay(12);
    }
}

// --------------------
// Blickrichtungen
// --------------------
void lookLeft() {
    pupilOffsetX = -3;
}

void lookRight() {
    pupilOffsetX = 3;
}

void lookCenter() {
    pupilOffsetX = 0;
}

// --------------------
// Setup
// --------------------
void setup() {

    Serial.begin(115200);

    if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
        while (true);
    }

    panServo.attach(5);
    tiltServo.attach(6);

    panServo.write(90);
    tiltServo.write(90);

    lookCenter();

    drawFace(eyeHeight);

    delay(1000);
}

// --------------------
// Loop
// --------------------
void loop() {

    // --------------------
    // Serial empfangen
    // --------------------
    if (Serial.available()) {

        String command = Serial.readStringUntil('\n');
        command.trim();

        // --------------------
        // PAN
        // --------------------
        int panIndex = command.indexOf("PAN:");
        int comma1 = command.indexOf(",");

        if (panIndex >= 0 && comma1 > panIndex) {

            String panStr = command.substring(
                panIndex + 4,
                comma1
            );

            panPos = constrain(panStr.toInt(), 20, 160);

            panServo.write(panPos);
        }

        // --------------------
        // TILT
        // --------------------
        int tiltIndex = command.indexOf("TILT:");
        int comma2 = command.indexOf(",", tiltIndex);

        if (tiltIndex >= 0) {

            String tiltStr;

            if (comma2 > tiltIndex) {
                tiltStr = command.substring(tiltIndex + 5, comma2);
            } else {
                tiltStr = command.substring(tiltIndex + 5);
            }

            tiltPos = constrain(tiltStr.toInt(), 20, 160);

            tiltServo.write(tiltPos);
        }

        // --------------------
        // Viseme
        // --------------------
        int visemeIndex = command.indexOf("V:");

        if (visemeIndex >= 0) {

            currentViseme = command.substring(visemeIndex + 2);
            currentViseme.trim();
        }

        // --------------------
        // Blickrichtung
        // --------------------
        if (panPos > oldPanPos) {
            lookRight();
        }
        else if (panPos < oldPanPos) {
            lookLeft();
        }
        else {
            lookCenter();
        }

        oldPanPos = panPos;

        drawFace(eyeHeight);
    }

    // Automatisches Blinzeln
    static unsigned long lastBlink = 0;

    if (millis() - lastBlink > 4000) {

        blink();

        lastBlink = millis();
    }
}
