# ----------------------------
# Hilfsfunktionen Tracking
# ----------------------------
def ema(prev, new, alpha):
    if prev is None:
        return float(new)
    return alpha * float(new) + (1.0 - alpha) * float(prev)


def apply_deadzone(error, deadzone):
    if abs(error) < deadzone:
        return 0.0
    return error


def send_tracking_error_to_arduino(pan_error, tilt_error, force=False):
    global last_serial_send, current_viseme
    pan_error = float(np.clip(pan_error, -1.0, 1.0))
    tilt_error = float(np.clip(tilt_error, -1.0, 1.0))
    set_status(
        "tracking",
        f"PAN {pan_error:.3f} | TILT {tilt_error:.3f}",
        "Aktuell berechnete Tracking-Fehlerwerte"
    )
    if arduino is None:
        return

    now = time.time()
    if not force and (now - last_serial_send) < SERVO_SEND_INTERVAL:
        return

    command = (
        f"PAN:{pan_error:.3f},"
        f"TILT:{tilt_error:.3f},"
        f"V:{current_viseme}\n"
    )

    try:
        arduino.write(command.encode("utf-8"))
        last_serial_send = now
        set_status("servo", "Tracking", f"PAN_ERR {pan_error:.3f} / TILT_ERR {tilt_error:.3f}")
    except Exception as e:
        set_status("serial", "Fehler", str(e))
        print("Serial Fehler (Tracking):", e)


def update_viseme(viseme):
