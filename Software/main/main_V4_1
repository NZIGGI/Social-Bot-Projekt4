# Face Tracking
# ----------------------------
def face_tracking_loop():
    global smoothed_face_x, smoothed_face_y

    options = mp_vision.FaceDetectorOptions(
        base_options=mp_base.BaseOptions(
            model_asset_path=FACE_MODEL_PATH

        ),
        min_detection_confidence=FACE_DETECTION_CONFIDENCE
    )
    set_status("camera", "Starte", f"Öffne Kamera Index {CAMERA_INDEX}")

    cap = cv2.VideoCapture(CAMERA_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAMERA_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAMERA_HEIGHT)
    window_name= "Face Tracking"

    camera_window_visible = False

    if not cap.isOpened():
        set_status("camera", "Fehler", f"Kamera Index {CAMERA_INDEX} konnte nicht geöffnet werden")
        return

    with mp_vision.FaceDetector.create_from_options(options) as detector:
        while not tracking_stop_event.is_set():
            ret, frame = cap.read()
            if not ret or frame is None:
                set_status("camera", "Fehler", f"Kamera Index {CAMERA_INDEX} liefert kein Bild")
                break

            h, w = frame.shape[:2]
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
            result = detector.detect(mp_image)

            if result.detections:
                det = result.detections[0]
                bbox = det.bounding_box
                center_x = bbox.origin_x + bbox.width / 2
                center_y = bbox.origin_y + bbox.height / 2

                smoothed_face_x = ema(smoothed_face_x, center_x, TRACKING_SMOOTHING)
                smoothed_face_y = ema(smoothed_face_y, center_y, TRACKING_SMOOTHING)

                error_x_px = smoothed_face_x - (w / 2)
                error_y_px = smoothed_face_y - (h / 2)

                error_x_px = apply_deadzone(error_x_px, TRACKING_DEADZONE_PIXELS)
                error_y_px = apply_deadzone(error_y_px, TRACKING_DEADZONE_PIXELS)

                norm_x = error_x_px / (w / 2)
                norm_y = error_y_px / (h / 2)

                send_pan_error = float(np.clip(norm_x, -1.0, 1.0))
                send_tilt_error = float(np.clip(norm_y, -1.0, 1.0))

                send_tracking_error_to_arduino(send_pan_error, send_tilt_error)


                cv2.rectangle(
                    frame,
                    (bbox.origin_x, bbox.origin_y),
                    (bbox.origin_x + bbox.width, bbox.origin_y + bbox.height),
                    (0, 255, 0), 2
                )
                cv2.circle(frame, (int(smoothed_face_x), int(smoothed_face_y)), 5, (255, 0, 0), -1)

                cv2.line(frame, (w // 2 - TRACKING_DEADZONE_PIXELS, 0), (w // 2 - TRACKING_DEADZONE_PIXELS, h), (80, 80, 80), 1)
                cv2.line(frame, (w // 2 + TRACKING_DEADZONE_PIXELS, 0), (w // 2 + TRACKING_DEADZONE_PIXELS, h), (80, 80, 80), 1)
                cv2.line(frame, (0, h // 2 - TRACKING_DEADZONE_PIXELS), (w, h // 2 - TRACKING_DEADZONE_PIXELS), (80, 80, 80), 1)
                cv2.line(frame, (0, h // 2 + TRACKING_DEADZONE_PIXELS), (w, h // 2 + TRACKING_DEADZONE_PIXELS), (80, 80, 80), 1)
            else:
                smoothed_face_x = None
                smoothed_face_y = None
                send_tracking_error_to_arduino(0.0, 0.0)

            if SHOW_CAMERA_WINDOW:
                overlay = (
                    f"Cam {CAMERA_INDEX} | "
                    f"Conf {FACE_DETECTION_CONFIDENCE:.2f} | "
                    f"Smooth {TRACKING_SMOOTHING:.2f} | "
                    f"Deadzone {TRACKING_DEADZONE_PIXELS}px | "
                    f"Send {SERVO_SEND_INTERVAL:.2f}s"
                )
                cv2.putText(frame, overlay, (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 255, 255), 2)
                cv2.imshow("Face Tracking", frame)
                if cv2.waitKey(1) & 0xFF ==27:
                    break


    cap.release()
    cv2.destroyAllWindows()
    set_status("camera", "Gestoppt", "Face-Tracking beendet")
def start_tracking():
    global tracking_thread

    if tracking_thread is not None and tracking_thread.is_alive():
        return

    tracking_stop_event.clear()
    tracking_thread = threading.Thread(target=face_tracking_loop, daemon=True)
    tracking_thread.start()


def stop_tracking():
    global tracking_thread

    tracking_stop_event.set()

    if tracking_thread is not None and tracking_thread.is_alive():
        tracking_thread.join(timeout=2.0)

    tracking_thread = None


