    def apply_settings(self):
        global COMMAND_SECONDS, FOLLOWUP_SECONDS, WAKE_THRESHOLD
        global CAMERA_INDEX, SERIAL_PORT, SERIAL_BAUD
        global SHOW_CAMERA_WINDOW
        global FACE_DETECTION_CONFIDENCE, TRACKING_SMOOTHING
        global TRACKING_DEADZONE_PIXELS, SERVO_SEND_INTERVAL

        try:
            command_seconds = int(self.param_vars["command_seconds"].get())
            followup_seconds = int(self.param_vars["followup_seconds"].get())
            wake_threshold = float(self.param_vars["wake_threshold"].get())
            camera_index = int(self.param_vars["camera_index"].get())
            face_detection_confidence = float(self.param_vars["face_detection_confidence"].get())
            tracking_smoothing = float(self.param_vars["tracking_smoothing"].get())
            tracking_deadzone_pixels = int(self.param_vars["tracking_deadzone_pixels"].get())
            servo_send_interval = float(self.param_vars["servo_send_interval"].get())
            serial_port = self.param_vars["serial_port"].get().strip()
            serial_baud = int(self.param_vars["serial_baud"].get())
            show_camera_window = bool(self.param_vars["show_camera_window"].get())

            if not (0.0 <= wake_threshold <= 1.0):
                raise ValueError("Wake Threshold muss zwischen 0.0 und 1.0 liegen.")
            if not (0.0 <= face_detection_confidence <= 1.0):
                raise ValueError("Gesichts-Sensibilität muss zwischen 0.0 und 1.0 liegen.")
            if not (0.01 <= tracking_smoothing <= 1.0):
                raise ValueError("Tracking-Glättung muss zwischen 0.01 und 1.0 liegen.")
            if not (0 <= tracking_deadzone_pixels <= 300):
                raise ValueError("Deadzone muss zwischen 0 und 300 Pixel liegen.")
            if not (0.01 <= servo_send_interval <= 1.0):
                raise ValueError("Sendeintervall muss zwischen 0.01 und 1.0 Sekunden liegen.")
            if command_seconds < 1 or followup_seconds < 1:
                raise ValueError("Aufnahmezeiten müssen mindestens 1 Sekunde sein.")
            if not serial_port:
                raise ValueError("Serial Port darf nicht leer sein.")

            COMMAND_SECONDS = command_seconds
            FOLLOWUP_SECONDS = followup_seconds
            WAKE_THRESHOLD = wake_threshold
            CAMERA_INDEX = camera_index
            FACE_DETECTION_CONFIDENCE = face_detection_confidence
            TRACKING_SMOOTHING = tracking_smoothing
            TRACKING_DEADZONE_PIXELS = tracking_deadzone_pixels
            SERVO_SEND_INTERVAL = servo_send_interval
            stop_tracking()
            time.sleep(0.3)
            start_tracking()
            SERIAL_PORT = serial_port
            SERIAL_BAUD = serial_baud
            SHOW_CAMERA_WINDOW = show_camera_window

            set_status("conversation", "Konfiguriert", "Parameter wurden übernommen")
            set_status(
                "camera",
                "Konfiguriert",
                f"Kamera {CAMERA_INDEX} | Sens {FACE_DETECTION_CONFIDENCE:.2f} | Smooth {TRACKING_SMOOTHING:.2f} | Deadzone {TRACKING_DEADZONE_PIXELS}px"
            )
            set_status(
                "servo",
                "Konfiguriert",
                f"PID-Fehlerwerte | Intervall {SERVO_SEND_INTERVAL:.2f}s | Baud {SERIAL_BAUD}"
            )

            messagebox.showinfo(
                "Einstellungen",
                "Parameter erfolgreich übernommen.\n"
                "Hinweis: Änderungen an Kamera/Gesichtserkennung greifen im laufenden Tracking meist erst nach Neustart des Tracking-Threads vollständig."
            )
        except Exception as e:
            messagebox.showerror("Fehler", f"Einstellungen konnten nicht übernommen werden:\n{e}")

