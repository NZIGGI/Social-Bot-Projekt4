def record_audio(seconds, sample_rate=SAMPLE_RATE):
    audio = sd.rec(
        int(seconds * sample_rate),
        samplerate=sample_rate,
        channels=1,
        dtype=np.float32
    )
    sd.wait()

    audio_mono = audio.squeeze()

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        temp_wav = f.name

    wavfile.write(temp_wav, sample_rate, (audio_mono * 32767).astype(np.int16))
    return temp_wav


def transcribe_audio(path: str):
    sample_rate, audio = scipy_wavfile.read(path)

    if audio.ndim > 1:
        audio = audio.mean(axis=1)

    if np.issubdtype(audio.dtype, np.integer):
        max_value = float(np.iinfo(audio.dtype).max)
        audio = audio.astype(np.float32) / max_value
    else:
        audio = audio.astype(np.float32)

    if sample_rate != SAMPLE_RATE:
        raise RuntimeError(f"Unerwartete Abtastrate: {sample_rate} Hz")

    result = stt_model.transcribe(audio, language="de", fp16=False)
    return result["text"].strip()


def ask_ollama(messages):
    resp = ollama.chat(model="llama3.2", messages=messages)
    return resp["message"]["content"].strip()


def listen_for_command(seconds):
    wav_path = record_audio(seconds)
    try:
        text = transcribe_audio(wav_path)
    finally:
        try:
            os.remove(wav_path)
        except OSError:
            pass
    return text

