def send_state_to_arduino(force=False):
    global last_serial_send

    if arduino is None:
        return

    now = time.time()
    if not force and (now - last_serial_send) < SERVO_SEND_INTERVAL:
        return

    with state_lock:
        pan = int(np.clip(current_pan, SERVO_MIN, SERVO_MAX))
        tilt = int(np.clip(current_tilt, SERVO_MIN, SERVO_MAX))
        viseme = current_viseme

    command = f"PAN:{pan},TILT:{tilt},V:{viseme}\n"

    try:
        arduino.write(command.encode("utf-8"))
        last_serial_send = now
        set_status("servo", "Aktiv", f"PAN {pan} / TILT {tilt} / V {viseme}")
    except Exception as e:
        set_status("serial", "Fehler", str(e))
        print("Serial Fehler:", e)


