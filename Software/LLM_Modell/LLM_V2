class TalkingFaceApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Jarvis Face")
        self.root.configure(bg=BG)

        self.canvas = tk.Canvas(
            root,
            width=WINDOW_W,
            height=WINDOW_H,
            bg=BG,
            highlightthickness=0
        )
        self.canvas.pack()

        self.timeline = []
        self.duration = 0.0
        self.start_time = None
        self.running = False
        self.wav_path = None
        self.current_viseme = "REST"

        self.draw_face("REST", 1.0, 0.0)

    def draw_mouth_shape(self, cx, cy, viseme):
        if viseme == "REST":
            self.canvas.create_line(cx - 70, cy, cx + 70, cy, fill=MOUTH, width=6, smooth=True)
        elif viseme == "M":
            self.canvas.create_line(cx - 75, cy, cx + 75, cy, fill=MOUTH, width=8, smooth=True)
            self.canvas.create_line(cx - 55, cy + 8, cx + 55, cy + 8, fill="#994455", width=2, smooth=True)
        elif viseme == "F":
            self.canvas.create_oval(cx - 75, cy - 12, cx + 75, cy + 20, fill=MOUTH, outline=MOUTH)
            self.canvas.create_rectangle(cx - 35, cy - 4, cx + 35, cy + 4, fill="#F4F4F4", outline="")
        elif viseme == "A":
            self.canvas.create_oval(cx - 85, cy - 55, cx + 85, cy + 55, fill=MOUTH, outline=MOUTH)
            self.canvas.create_oval(cx - 55, cy - 30, cx + 55, cy + 38, fill=MOUTH_INNER, outline=MOUTH_INNER)
        elif viseme == "E":
            self.canvas.create_oval(cx - 95, cy - 30, cx + 95, cy + 30, fill=MOUTH, outline=MOUTH)
            self.canvas.create_oval(cx - 65, cy - 14, cx + 65, cy + 16, fill=MOUTH_INNER, outline=MOUTH_INNER)
        elif viseme == "O":
            self.canvas.create_oval(cx - 42, cy - 52, cx + 42, cy + 52, fill=MOUTH, outline=MOUTH)
            self.canvas.create_oval(cx - 22, cy - 26, cx + 22, cy + 30, fill=MOUTH_INNER, outline=MOUTH_INNER)
        elif viseme == "S":
            self.canvas.create_oval(cx - 80, cy - 20, cx + 80, cy + 24, fill=MOUTH, outline=MOUTH)
            self.canvas.create_line(cx - 55, cy + 2, cx + 55, cy + 2, fill="#F2F2F2", width=3)
        else:
            self.canvas.create_line(cx - 70, cy, cx + 70, cy, fill=MOUTH, width=6, smooth=True)

    def draw_face(self, viseme, blink, t):
        self.canvas.delete("all")

        cx, cy = WINDOW_W // 2, WINDOW_H // 2
        face_w, face_h = 420, 500

        self.canvas.create_oval(
            cx - face_w // 2, cy - face_h // 2,
            cx + face_w // 2, cy + face_h // 2,
            fill=FACE, outline=OUTLINE, width=4
        )

        cheek_offset = 4 * math.sin(t * 1.5)
        self.canvas.create_oval(cx - 150, cy + 20 + cheek_offset, cx - 95, cy + 75 + cheek_offset, fill=CHEEK, outline="")
        self.canvas.create_oval(cx + 95, cy + 20 + cheek_offset, cx + 150, cy + 75 + cheek_offset, fill=CHEEK, outline="")

        self.canvas.create_line(cx - 185, cy - 130, cx - 85, cy - 140, fill=OUTLINE, width=5, smooth=True)
        self.canvas.create_line(cx + 85, cy - 140, cx + 185, cy - 130, fill=OUTLINE, width=5, smooth=True)

        eye_y = cy - 80
        eye_h_open = 42
        eye_h = max(4, int(eye_h_open * blink))

        if eye_h <= 6:
            self.canvas.create_line(cx - 170, eye_y, cx - 90, eye_y, fill=EYE, width=6)
            self.canvas.create_line(cx + 90, eye_y, cx + 170, eye_y, fill=EYE, width=6)
        else:
            self.canvas.create_oval(cx - 170, eye_y - eye_h // 2, cx - 90, eye_y + eye_h // 2, fill=EYE, outline=EYE)
            self.canvas.create_oval(cx + 90, eye_y - eye_h // 2, cx + 170, eye_y + eye_h // 2, fill=EYE, outline=EYE)

        self.canvas.create_line(cx, cy - 20, cx - 18, cy + 40, cx + 18, cy + 40, fill=OUTLINE, width=4, smooth=True)

        mouth_y = cy + 145
        self.draw_mouth_shape(cx, mouth_y, viseme)

    def current_viseme_from_time(self, elapsed):
        for start, end, vis in self.timeline:
            if start <= elapsed < end:
                return vis
        return "REST"

    def play_text(self, text: str):
        global assistant_paused

        if self.running:
            return

        assistant_paused = True

        self.wav_path = synthesize_to_wav(text)
        self.duration = get_wav_duration(self.wav_path)
        self.timeline = build_viseme_timeline(text, self.duration)

        self.start_time = time.perf_counter()
        self.running = True

        winsound.PlaySound(self.wav_path, winsound.SND_FILENAME | winsound.SND_ASYNC)
        self.animate()

    def animate(self):
        global assistant_paused

        if not self.running:
            return

        elapsed = time.perf_counter() - self.start_time

        if elapsed >= self.duration + 0.15:
            self.running = False
            assistant_paused = False
            winsound.PlaySound(None, 0)
            self.draw_face("REST", 1.0, elapsed)

            if self.wav_path:
                try:
                    os.remove(self.wav_path)
                except OSError:
                    pass
                self.wav_path = None
            return

        viseme = self.current_viseme_from_time(elapsed)
        self.current_viseme = viseme

        blink = 1.0
        blink_cycle = elapsed % 4.0
        if 3.55 < blink_cycle < 3.72:
            blink = max(0.08, 1.0 - ((blink_cycle - 3.55) / 0.17))
        elif 3.72 <= blink_cycle < 3.89:
            blink = max(0.08, (blink_cycle - 3.72) / 0.17)

        self.draw_face(self.current_viseme, blink, elapsed)
        self.root.after(FRAME_MS, self.animate)

# ----------------------------
# Konversation
# ----------------------------
def reset_conversation():
    global conversation_active, messages
    conversation_active = False
    messages = [SYSTEM_PROMPT.copy()]
    print("🔄 Konversation zurückgesetzt. Warte wieder auf 'Hey Jarvis'.")

def handle_user_text(user_text: str, face_app: TalkingFaceApp):
    global messages

    print("🎤 Du:", user_text)

    messages.append({"role": "user", "content": user_text})
    answer = ask_ollama(messages)
    messages.append({"role": "assistant", "content": answer})

    print("🤖 Antwort:", answer)

    face_app.root.after(0, lambda: face_app.play_text(answer))

# ----------------------------
# Wake Word
# ----------------------------
def audio_callback(indata, frames, time_info, status):
    global wake_detected, assistant_paused

    if assistant_paused:
        return

    if status:
        print("Audio-Status:", status)

    pcm = (indata[:, 0] * 32767).astype(np.int16)
    prediction = wake_model.predict(pcm)

    score = prediction.get(WAKE_MODEL_NAME, 0.0)
    if score >= WAKE_THRESHOLD:
        wake_detected = True

# ----------------------------
# Hintergrund-Loop
# ----------------------------
def assistant_loop(face_app: TalkingFaceApp):
    global wake_detected, conversation_active

    with sd.InputStream(
        samplerate=SAMPLE_RATE,
        channels=CHANNELS,
        dtype="float32",
        blocksize=blocksize,
        callback=audio_callback
    ):
        while True:
            try:
                if assistant_paused:
                    time.sleep(0.05)
                    continue

                if not conversation_active:
                    if wake_detected:
                        wake_detected = False
                        conversation_active = True
                        print("✅ Wake Word erkannt: hey_jarvis")
                        face_app.root.after(0, lambda: face_app.play_text("Ja?"))

                        while face_app.running:
                            time.sleep(0.05)

                        print("🎤 Hör zu...")
                        user_text = listen_for_command(COMMAND_SECONDS)

                        if not user_text:
                            print("⚠️ Nichts verstanden.")
                            face_app.root.after(0, lambda: face_app.play_text("Ich habe nichts verstanden."))

                            while face_app.running:
                                time.sleep(0.05)

                            reset_conversation()
                            continue

                        handle_user_text(user_text, face_app)

                        while face_app.running:
                            time.sleep(0.05)

                else:
                    print(f"⏳ Du hast {FOLLOWUP_SECONDS} Sekunden Zeit zum Antworten...")
                    followup_text = listen_for_command(FOLLOWUP_SECONDS)

                    if not followup_text:
                        print("⌛ Keine Antwort. Konversation beendet.")
                        face_app.root.after(0, lambda: face_app.play_text("Okay."))

                        while face_app.running:
                            time.sleep(0.05)

                        reset_conversation()
                        continue

                    handle_user_text(followup_text, face_app)

                    while face_app.running:
                        time.sleep(0.05)

                time.sleep(0.05)

            except Exception as e:
                print("❌ Fehler:", e)
                time.sleep(1)

