def record_audio(seconds, sample_rate=SAMPLE_RATE):
    audio = sd.rec(
        int(seconds * sample_rate),
        samplerate=sample_rate,
        channels=1,
        dtype=np.float32
    )
    sd.wait()

    audio_mono = audio.squeeze()

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        temp_wav = f.name

    wavfile.write(temp_wav, sample_rate, (audio_mono * 32767).astype(np.int16))
    return temp_wav

def transcribe_audio(path: str):
    result = stt_model.transcribe(path, language="de")
    return result["text"].strip()

def ask_ollama(messages):
    resp = ollama.chat(
        model="llama3.2",
        messages=messages
    )
    return resp["message"]["content"].strip()

def listen_for_command(seconds):
    wav_path = record_audio(seconds)
    try:
        text = transcribe_audio(wav_path)
    finally:
        try:
            os.remove(wav_path)
        except OSError:
            pass
    return text

# ----------------------------
# TTS + Viseme
# ----------------------------
def synthesize_to_wav(text: str) -> str:
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        out_wav = f.name

    result = subprocess.run(
        [
            PIPER_EXE,
            "-m", PIPER_MODEL,
            "-c", PIPER_CONFIG,
            "-f", out_wav
        ],
        input=text,
        text=True,
        capture_output=True
    )

    if result.returncode != 0:
        raise RuntimeError(
            f"Piper-Fehler\nSTDOUT:\n{result.stdout}\nSTDERR:\n{result.stderr}"
        )

    if not os.path.exists(out_wav) or os.path.getsize(out_wav) == 0:
        raise RuntimeError("Piper hat keine gültige WAV-Datei erzeugt.")

    return out_wav

def get_wav_duration(wav_path: str) -> float:
    rate, data = scipy_wavfile.read(wav_path)
    return len(data) / rate if rate > 0 else 0.0

def text_to_phonemes(text: str):
    sep = Separator(phone=" ", word="|", syllable=None)

    phones = phonemize(
        text,
        language="de",
        backend="espeak",
        separator=sep,
        strip=True,
        preserve_punctuation=False,
        with_stress=False
    )

    phones = phones.replace("|", " ")
    return [p for p in phones.split() if p]

def phoneme_to_viseme(ph: str) -> str:
    ph = ph.lower()

    if ph in {"m", "b", "p"}:
        return "M"
    if ph in {"f", "v"}:
        return "F"
    if ph in {"o", "oː", "ɔ", "ɔʏ", "u", "uː", "ʊ", "w"}:
        return "O"
    if ph in {"e", "eː", "i", "iː", "ɪ", "ɛ", "ɛː", "y", "yː", "ø", "øː"}:
        return "E"
    if ph in {"a", "aː", "ɑ", "ä"}:
        return "A"
    if ph in {
        "s", "z", "ʃ", "ʒ", "ç", "x", "h",
        "t", "d", "k", "g", "n", "ŋ", "l", "r", "j", "ts", "tʃ", "pf"
    }:
        return "S"

    return "REST"

def build_viseme_timeline(text: str, total_duration: float):
    phonemes = text_to_phonemes(text)

    if not phonemes or total_duration <= 0:
        return [(0.0, max(0.1, total_duration), "REST")]

    weights = []
    for ph in phonemes:
        vis = phoneme_to_viseme(ph)
        if vis in {"A", "E", "O"}:
            weights.append(1.6)
        elif vis in {"M", "F"}:
            weights.append(1.1)
        elif vis == "S":
            weights.append(1.0)
        else:
            weights.append(0.8)

    total_weight = sum(weights) if sum(weights) > 0 else 1.0
    lead_in = min(0.06, total_duration * 0.08)

    timeline = []
    current = 0.0

    if lead_in > 0:
        timeline.append((0.0, lead_in, "REST"))
        current = lead_in

    usable_duration = max(0.0, total_duration - lead_in)

    for ph, w in zip(phonemes, weights):
        dur = usable_duration * (w / total_weight)
        vis = phoneme_to_viseme(ph)
        timeline.append((current, current + dur, vis))
        current += dur

    if timeline:
        start, _, last_vis = timeline[-1]
        timeline[-1] = (start, total_duration, last_vis)

    return timeline

