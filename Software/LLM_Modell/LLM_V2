# Start
# ----------------------------
if __name__ == "__main__":
    root = tk.Tk()
    face_app = TalkingFaceApp(root)

    thread = threading.Thread(target=assistant_loop, args=(face_app,), daemon=True)
    thread.start()

    root.mainloop()
